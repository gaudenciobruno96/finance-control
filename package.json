{
  "name": "finance-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Controle orçamentário pessoal — PWA offline com dados locais",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p mcp/tsconfig.json",
    "mcp": "tsx mcp/server.ts",
    "mcp:http": "tsx mcp/main-http.ts",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run audit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "testcontainers": "^12.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "express": "^5.2.1",
    "fake-indexeddb": "6.2.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  }
}
